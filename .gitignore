cat > .gitignore << 'EOF'
# Environment
.env

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
env/
.venv/

# ChromaDB & uploads (local data)
data/chroma_db/
data/uploads/

# Logs
logs/
*.log

# SQLite databases
*.db
*.sqlite

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
EOF
